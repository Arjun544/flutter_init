{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["bun-types"]
  },
  "include": ["bin/**/*", "src/**/*", "tests/**/*", "../shared/**/*"],
  "exclude": ["node_modules", "dist", "templates"]
}
