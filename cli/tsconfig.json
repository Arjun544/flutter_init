{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": ["bun-types"]
  },
  "include": ["bin/**/*", "src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "templates"]
}
