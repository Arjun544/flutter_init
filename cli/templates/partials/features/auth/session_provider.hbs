{{else if flags.isMobX}}
part 'session_store.g.dart';

class SessionStore = SessionStoreBase with _$SessionStore;

abstract class SessionStoreBase with Store, StreamSubscriptionsMixin {
  SessionStoreBase({required AuthRepository repository})
      : _repository = repository {
    _init();
  }

  final AuthRepository _repository;

  @observable
  SessionState state = const SessionUnknown();

  @computed
  AppUser? get user => state.userOrNull;

  @computed
  bool get isAuthenticated => state.isAuthenticated;

  @action
  Future<void> _init() async {
    final result = await _repository.checkAuthState();
    state = result.fold(
      (_) => const SessionUnauthenticated(),
      sessionFromUser,
    );

    addSubscription(
      _repository.onAuthStateChanged.listen((user) {
        runInAction(() {
          state = sessionFromUser(user);
        });
      }),
    );
  }

  @action
  Future<void> logout() async {
    await _repository.logout();
    state = const SessionUnauthenticated();
  }

  void dispose() {
    cancelSubscriptions();
  }
}
