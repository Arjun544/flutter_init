import '../../../../imports/imports.dart';
import 'package:shadcn_ui/shadcn_ui.dart';

/// Password [ShadInput] with visibility toggle, mirroring [AppPasswordField].
///
/// Usage:
/// ```dart
/// ShadAppPasswordField(
///   label: 'Password',
///   controller: _passwordController,
/// )
/// ```
class ShadAppPasswordField extends StatefulWidget {
  const ShadAppPasswordField({
    super.key,
    this.label = 'Password',
    this.hint,
    this.controller,
    this.onChanged,
    this.onSubmitted,
    this.focusNode,
    this.textInputAction,
    this.enabled = true,
    this.autofocus = false,
  });

  final String? label;
  final String? hint;
  final TextEditingController? controller;
  final ValueChanged<String>? onChanged;
  final ValueChanged<String>? onSubmitted;
  final FocusNode? focusNode;
  final TextInputAction? textInputAction;
  final bool enabled;
  final bool autofocus;

  @override
  State<ShadAppPasswordField> createState() => _ShadAppPasswordFieldState();
}

class _ShadAppPasswordFieldState extends State<ShadAppPasswordField> {
  bool _obscure = true;

  @override
  Widget build(BuildContext context) {
    final input = ShadInput(
      controller: widget.controller,
      focusNode: widget.focusNode,
      textInputAction: widget.textInputAction,
      obscureText: _obscure,
      enabled: widget.enabled,
      autofocus: widget.autofocus,
      onChanged: widget.onChanged,
      onSubmitted: widget.onSubmitted,
      placeholder: widget.hint != null ? Text(widget.hint!) : null,
      trailing: ShadIconButton.ghost(
        icon: Icon(_obscure ? Icons.visibility_outlined : Icons.visibility_off_outlined),
        onPressed: () => setState(() => _obscure = !_obscure),
        width: 32,
        height: 32,
        padding: EdgeInsets.zero,
      ),
    );

    if (widget.label == null) return input;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      mainAxisSize: MainAxisSize.min,
      children: [
        Text(widget.label!, style: ShadTheme.of(context).textTheme.small),
        const SizedBox(height: 6),
        input,
      ],
    );
  }
}
