import '../../../../imports/imports.dart';
import 'package:shadcn_ui/shadcn_ui.dart';

/// Thin [ShadDialog] helpers mirroring [AppDialog] / [AppAlertDialog].
///
/// Usage:
/// ```dart
/// await ShadAppDialog.show(
///   context,
///   title: 'Edit profile',
///   child: ...,
///   actions: [ShadButton(child: Text('Save'), onPressed: () => Navigator.pop(context))],
/// );
/// ```
class ShadAppDialog {
  const ShadAppDialog._();

  /// Shows a primary [ShadDialog] via [showShadDialog].
  static Future<T?> show<T>(
    BuildContext context, {
    Widget? title,
    Widget? description,
    Widget? child,
    List<Widget>? actions,
    bool alert = false,
  }) {
    return showShadDialog<T>(
      context: context,
      builder: (context) {
        if (alert) {
          return ShadDialog.alert(
            title: title,
            description: description,
            actions: actions ?? const [],
            child: child,
          );
        }
        return ShadDialog(
          title: title,
          description: description,
          actions: actions ?? const [],
          child: child,
        );
      },
    );
  }
}

/// Widget form of [ShadDialog] for embedding in custom flows.
class ShadAppDialogView extends StatelessWidget {
  const ShadAppDialogView({
    super.key,
    this.title,
    this.description,
    this.child,
    this.actions = const [],
    this.alert = false,
  });

  final Widget? title;
  final Widget? description;
  final Widget? child;
  final List<Widget> actions;
  final bool alert;

  @override
  Widget build(BuildContext context) {
    if (alert) {
      return ShadDialog.alert(
        title: title,
        description: description,
        actions: actions,
        child: child,
      );
    }
    return ShadDialog(
      title: title,
      description: description,
      actions: actions,
      child: child,
    );
  }
}
