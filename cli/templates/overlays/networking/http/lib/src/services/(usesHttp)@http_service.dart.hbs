import 'dart:convert';
import 'package:http/http.dart' as http;
import '../config/app_config.dart';
import '../utils/utils.dart';

/// A lightweight networking service powered by the http package.
/// Network logging is handled by [LoggingHttpClient] middleware.
class HttpService {
  HttpService._();
  static final HttpService instance = HttpService._();

  FutureEither<http.Response> get(String path, {Map<String, String>? headers}) {
    return runTask(
      () => AppConfig.httpClient.get(
        Uri.parse('${AppConfig.baseUrl}$path'),
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          ...?headers,
        },
      ),
      operation: 'http.get',
      category: LogCategory.network,
      context: {'path': path},
      requiresNetwork: true,
    );
  }

  FutureEither<http.Response> post(String path, {dynamic body, Map<String, String>? headers}) {
    return runTask(
      () => AppConfig.httpClient.post(
        Uri.parse('${AppConfig.baseUrl}$path'),
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          ...?headers,
        },
        body: jsonEncode(body),
      ),
      operation: 'http.post',
      category: LogCategory.network,
      context: {'path': path},
      requiresNetwork: true,
    );
  }

  FutureEither<http.Response> put(String path, {dynamic body, Map<String, String>? headers}) {
    return runTask(
      () => AppConfig.httpClient.put(
        Uri.parse('${AppConfig.baseUrl}$path'),
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          ...?headers,
        },
        body: jsonEncode(body),
      ),
      operation: 'http.put',
      category: LogCategory.network,
      context: {'path': path},
      requiresNetwork: true,
    );
  }

  FutureEither<http.Response> delete(String path, {Map<String, String>? headers}) {
    return runTask(
      () => AppConfig.httpClient.delete(
        Uri.parse('${AppConfig.baseUrl}$path'),
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          ...?headers,
        },
      ),
      operation: 'http.delete',
      category: LogCategory.network,
      context: {'path': path},
      requiresNetwork: true,
    );
  }
}
