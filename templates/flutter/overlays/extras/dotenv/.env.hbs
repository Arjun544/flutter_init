# ─────────────────────────────────────────────────────────────
# {{appName}} — Environment Configuration
# ─────────────────────────────────────────────────────────────
# These values are bundled client configuration, not secrets.
# Keep private credentials on your server.

{{#if (eq backend.provider "firebase")}}
# ── Firebase ──────────────────────────────────────────────────
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
{{/if}}
{{#if (eq backend.provider "supabase")}}
# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
{{/if}}
{{#if (eq backend.provider "appwrite")}}
# ── Appwrite ──────────────────────────────────────────────────
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_DATABASE_ID=your-database-id
APPWRITE_BUCKET_ID=your-bucket-id
{{/if}}
{{#if (or flags.usesDio flags.usesHttp)}}
# ── API ───────────────────────────────────────────────────────
API_BASE_URL={{#if (eq backend.provider "custom")}}{{backend.options.baseUrl}}{{else}}https://api.example.com{{/if}}
{{/if}}
# ── App ───────────────────────────────────────────────────────
APP_NAME={{appName}}
APP_ENV=development
